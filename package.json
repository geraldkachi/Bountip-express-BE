{
  "name": "bountip-express",
  "version": "1.0.0",
  "description": "Bountip Bake Platform – Express + MongoDB",
  "scripts": {
    "dev":   "ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test":  "jest --forceExit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "uuid": "^9.0.0",
    "http-errors": "^2.0.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "ts-jest": "^29.1.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/http-errors": "^2.0.0",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.spec.ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "tsconfig": "tsconfig.test.json",
        "diagnostics": { "ignoreCodes": ["TS2683"] }
      }],
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": ["node_modules/(?!(uuid)/)"]
  }
}
